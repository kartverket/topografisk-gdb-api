server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 100m;

  types {
    text/html html;
    text/css css;
    application/javascript js mjs;
    image/svg+xml svg;
    font/woff2 woff2;
  }

  location = /index.html {
    add_header Cache-Control "no-store";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}