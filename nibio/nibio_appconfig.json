    "version": "1.0",
    "topology": {
        "srid": 4258,
        "snap_tolerance": 0.000000001
    },
    "extensions": [
        "uuid-ossp"
    ],
    "operations": {
        "SurfaceMerge": {
            "surfaceSQLFilter": "                      (             ST_Area(:S1.omrade::geometry::geography) <= CASE WHEN :S1.opphav = 'web' AND :S2.opphav = 'web' THEN 2000 ELSE 500 END             OR             ST_Area(:S2.omrade::geometry::geography) <= CASE WHEN :S1.opphav = 'web' AND :S2.opphav = 'web' THEN 2000 ELSE 500 END           )                      AND NOT           (             :S1.opphav in ('samf','vann')             OR             :S2.opphav in ('samf','vann')           ) ",
            "sharedSurfaceAttributes": [
                "arealtype",
                "treslag",
                "skogbonitet",
                "grunnforhold"
            ]
        },
        "GetFeaturesAsTopoJSON": {
        },
        "AddBordersSplitSurfaces": {
            "parameters": {
                "default": {
                    "snapTolerance": {
                        "units": 0.0000000001,
                        "unitsAreMeters": false
                    },
                    "minAllowedNewSurfacesArea": {
                        "units": 200,
                        "unitsAreMeters": true
                    },
                    "maxAllowedNewSurfacesCount": 2,
                    "maxAllowedSplitSurfacesCount": 1
                },
                "forOpenLines": {
                    "minAllowedNewSurfacesArea": {
                        "units": 10,
                        "unitsAreMeters": true
                    },
                    "maxAllowedNewSurfacesCount": 3
                }
            }
        }
    },
    "border_layer": {
        "geo_column": "grense",
        "table_name": "edge_attributes",
        "version_column": "identifikasjon_version_id"
    },
    "surface_layer": {
        "geo_column": "omrade",
        "table_name": "face_attributes",
        "version_column": "identifikasjon_version_id"
    }
}
